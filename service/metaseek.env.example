# =============================================================================
# Metaseek Environment Configuration
# Path: /etc/default/env/metaseek
# =============================================================================
#
# This file is loaded by systemd via EnvironmentFile= in the service unit.
# Variables here override the default configuration in metaseek.yml.
#
# Instructions:
# 1. Uncomment variables you wish to change.
# 2. Set `METASEEK_SETTINGS_PATH` if you are NOT using the default location.
# 3. Generate a strong `secret_key` for production.
# 4. Restart the service after changes: sudo systemctl restart metaseek
# =============================================================================

# -----------------------------------------------------------------------------
# General & Configuration
# -----------------------------------------------------------------------------

# Path to the metaseek.yml file.
# Defaults search order: Env var > ./metaseek.yml > ./config/metaseek.yml > /etc/metaseek/metaseek.yml
# If you keep the default location, you can leave this commented out.
# export METASEEK_SETTINGS_PATH="/etc/metaseek/metaseek.yml"

# Enable debug mode (logs more information). Set to true only for troubleshooting.
# export METASEEK_DEBUG="false"

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Bind address (IPv4 or IPv6). Default: 127.0.0.1
# To listen on all interfaces, change to "0.0.0.0" (ensure firewall is configured)
export METASEEK_BIND_ADDRESS="127.0.0.1"

# Server port. Default: 8888
export METASEEK_PORT="8888"

# Secret key for session signing and CSRF protection.
# IMPORTANT: Generate a long, random string for production.
# Example: openssl rand -hex 32
export METASEEK_SECRET_KEY="change-me-in-production"

# -----------------------------------------------------------------------------
# Search & Engine Configuration
# -----------------------------------------------------------------------------

# Safe search level: 0=None, 1=Moderate, 2=Strict
# export METASEEK_SAFE_SEARCH="0"

# Autocomplete backend: "duckduckgo", "google", "bing", etc.
# export METASEEK_AUTOCOMPLETE="duckduckgo"

# Default language: "auto", "en", "de", etc.
# export METASEEK_DEFAULT_LANG="auto"

# -----------------------------------------------------------------------------
# API Keys (Engine Specific)
# -----------------------------------------------------------------------------
# These variables allow overriding engine API keys at runtime without editing metaseek.yml.
# Note: The application also supports keys defined in metaseek.yml. These env vars act as overrides.

# LinkedIn Companies (Required API Key)
# export METASEEK_LINKEDIN_API_KEY=""

# GitHub (Optional: Increases rate limits)
# export METASEEK_GITHUB_API_KEY=""

# GitLab (Optional: Increases rate limits)
# export METASEEK_GITLAB_API_KEY=""

# -----------------------------------------------------------------------------
# Network & Proxies
# -----------------------------------------------------------------------------
# Uncomment and set these if you need to route traffic through a proxy.
# These are standard environment variable names used by Rust's Reqwest/Tokio stack.

# HTTP Proxy (for general web traffic)
# export HTTP_PROXY="http://proxy.example.com:8080"
# export http_proxy="http://proxy.example.com:8080"

# HTTPS Proxy (for secure traffic)
# export HTTPS_PROXY="http://proxy.example.com:8080"
# export https_proxy="http://proxy.example.com:8080"

# SOCKS Proxy (e.g., for Tor routing)
# export ALL_PROXY="socks5h://127.0.0.1:9050"
# export all_proxy="socks5h://127.0.0.1:9050"

# No-proxy list (comma-separated domains to bypass proxy)
# export NO_PROXY="localhost,127.0.0.1,.local"
# export no_proxy="localhost,127.0.0.1,.local"

# -----------------------------------------------------------------------------
# Advanced / Debugging
# -----------------------------------------------------------------------------

# Rust log level (for debugging issues)
# Options: off, error, warn, info, debug, trace
# export RUST_LOG="info"

# Enable metrics collection (if enabled in metaseek.yml)
# export METASEEK_ENABLE_METRICS="true"

# -----------------------------------------------------------------------------
# User & Directory Paths (Optional Overrides)
# -----------------------------------------------------------------------------

# If you want to override the cache or data directory path specifically
# export METASEEK_DATA_DIR="/var/lib/metaseek"
# export METASEEK_CACHE_DIR="/var/cache/metaseek"

